# Copy to .env.local for `npm run dev`. Values match the identity service in docker compose.
# Generate a real secret with: npx auth secret
AUTH_SECRET=dev-auth-secret-change-me-0123456789abcdef
# Public URL of this portal
AUTH_URL=http://localhost:3000
# Identity service as the browser sees it (must equal its ISSUER_URL)
AUTH_ISSUER=http://localhost:8000
# The portal client's secret (identity PORTAL_CLIENT_SECRET)
AUTH_CLIENT_SECRET=dev-portal-secret
# Identity service as this server reaches it
IDENTITY_API_URL=http://localhost:8000

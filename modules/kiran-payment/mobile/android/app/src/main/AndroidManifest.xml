<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- usesCleartextTraffic / networkSecurityConfig: the backend runs on a PC
         on the office network over plain http while this is a pilot. Without
         them Android refuses every request to it, as iOS does without its
         App Transport Security exception. -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">

        <!-- Portrait only. Every screen is a single column built for a thumb;
             landscape would stretch the conversation and the order cards
             without showing anything more.

             adjustResize: the web view shrinks above the keyboard, which keeps
             the conversation composer pinned on top of it — what the iOS
             build gets from the Keyboard plugin's native resize mode. -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Keeps a call's microphone and camera working when the app leaves
             the screen (CallService.java). -->
        <service
            android:name=".CallService"
            android:exported="false"
            android:foregroundServiceType="microphone|camera" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions. Android asks for the runtime ones (camera, photos,
         notifications) the first time the app uses them, as iOS does. -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Take a photo to send in a conversation or to attach a receipt to a claim. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Photos from the library need no permission: the Camera plugin opens
         the system photo picker, which hands over only the chosen photo. -->

    <!-- Remote notifications for mentions and dispatch updates (Android 13+
         asks for this at runtime). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Voice and video calls. The microphone (and the camera, above) are
         asked for the first time a call needs them; the web view's WebRTC
         also needs to change the audio mode. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- Staying on a call with the app in the background (CallService). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <!-- The screen going dark against your ear during a voice call. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- An incoming call shown over the lock screen. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
</manifest>

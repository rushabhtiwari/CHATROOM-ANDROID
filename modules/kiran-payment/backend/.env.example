# Anthropic API key used for receipt extraction.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Model used for receipt extraction. Haiku is fast and cheap, and handles
# images and PDFs natively.
RTS_EXTRACTION_MODEL=claude-haiku-4-5

# Server port. The Vite dev server proxies /api and /uploads here.
RTS_PORT=3001

# When true, Accounts approval is refused if the department has no budget
# headroom. Left off by default so a long demo can never dead-end.
RTS_ENFORCE_BUDGET=false

# Google Meet & Calendar. All optional.
#
# Without these the scheduling conversation still completes: it returns a
# placeholder Meet link and a real, pre-filled Google Calendar "add event"
# URL, and the meeting still appears on the console's own calendar. Supply
# them to create events on the company calendar and send invitations.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# One refresh token for both, or set the two separately below.
GOOGLE_REFRESH_TOKEN=
# GOOGLE_CALENDAR_REFRESH_TOKEN=
# GOOGLE_MEET_REFRESH_TOKEN=

# The zone meetings default to.
RTS_TIME_ZONE=Asia/Kolkata

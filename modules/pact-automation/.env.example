# Copy this file to .env and fill in. Never commit .env.

# Anthropic API key used by the verifier (screenshot check before Save)
ANTHROPIC_API_KEY=sk-ant-...

# Model for verification. Run  python verifier\verify.py --check  to list models your key can use.
VERIFIER_MODEL=claude-sonnet-4-5

# Which form map to use: a file name in profiles/ without .json
PROFILE=practice

# true = fill + verify but never press Save (safe mode)
DRY_RUN=false

# true = press Save automatically after verifier passes; false = wait for a human "Save" click on the page
AUTO_SAVE=true

# How often the Claude vision (screenshot) check runs:
#   every - once per row (safest, slowest, costs money per row)
#   first - once per batch, on the first row  (default; right for demos)
#   off   - never
# The exact read-back check is local and free and always runs, whatever this says.
VERIFY_MODE=first

# true = throw the resolved-control cache away after every New (the old behaviour).
# Leave false: a cold UI Automation resolve costs 2-9s per field.
COLD_CACHE_EACH_RECORD=false

# Server bind
HOST=127.0.0.1
PORT=8765

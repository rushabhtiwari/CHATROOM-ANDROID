# KiranOS backend configuration.
#
# Copy to `backend/.env`. Everything here has a working default except the mail
# credentials, so a fresh checkout runs the whole purchase-order pipeline with nothing
# configured — messages are written to the ledger and shown in the Mails table rather than
# transmitted, and PACT is only touched if KPAC is actually running.
#
# ⚠ `backend/.env` is git-ignored. Never commit a real password or API key.

# ---------------------------------------------------------------------------
# Mail — the two variables that make the demo send real messages
# ---------------------------------------------------------------------------
# Sending is opt-in. With SMTP_SEND unset, every message is still written to the ledger
# and readable in the console; it is simply not transmitted. That is what a rehearsal
# wants, and turning it on is one variable.
SMTP_SEND=false

# A Gmail address and a Google **app password** (not the account password). The IMAP and
# SMTP hosts are inferred from the address, so these two lines are the whole of it. You
# can also enter them in the console at /admin/mailing — credentials typed there are
# sealed to disk and outrank these.
IMAP_USER=
IMAP_APP_PASSWORD=

# Where customer-facing mail actually goes.
#
# The four demo customers live on `.example` domains, which are reserved and can never
# receive mail — deliberately, so a demo cannot mail a real company by accident. Set this
# to an inbox you own and every message written *for* a demo customer is delivered there
# instead, with the intended recipient kept on the ledger and named in the subject line.
#
# Leave it blank and nothing customer-facing leaves the machine at all.
DEMO_MAIL_REDIRECT=

# Who else may receive customer-facing demo mail: named addresses, and whole domains.
#
# The closing message states a dispatch date and a tracking reference that do not exist,
# so `po_pipeline.may_transmit` refuses any real recipient that is not opted in here. That
# guard is the reason a wrong environment variable cannot mail a real company.
#
# Set `DEMO_MAIL_ALLOWED_DOMAINS=gmail.com` for the demo where anybody may send an order
# from their own address: it pairs with `TRUSTED_SENDER_DOMAINS` below, so the same
# population that may send is the population that may be answered. Both are blank by
# default — opting a domain in is a decision that real mail leaves this machine.
DEMO_MAIL_ALLOWED=
DEMO_MAIL_ALLOWED_DOMAINS=

# Sender domains accepted without being in the company directory.
#
# The intake filter quarantines an unknown sender before extraction runs — right for a
# stranger, wrong for a demo where the orders arrive from whatever personal address is to
# hand. This says "read these", and nothing more: who the order is *for* still comes from
# the document, and still has to resolve in PACT's master. A trusted domain cannot smuggle
# in an unknown customer.
TRUSTED_SENDER_DOMAINS=gmail.com

# How the watcher waits between looks at the mailbox.
#
# The loop keeps one IMAP session open and asks the server to push a notification when
# mail arrives (IMAP IDLE), so a purchase order is noticed within a second or two of
# landing. MAIL_POLL_SECONDS is only the ceiling: the longest the loop waits before
# checking anyway, and the poll period for a server without IDLE. MAIL_IDLE=false turns
# the push off and polls on that schedule alone.
MAIL_POLL_SECONDS=20
MAIL_IDLE=true

# Extra phrases that make a message read as an order, on top of the built-in list
# ("purchase order", "po number", "kiran order", ...). Semicolon-separated.
ORDER_MARKERS_EXTRA=

# Who gets the internal "a PO arrived" notification. Comma-separated.
INTERNAL_NOTIFY_ADDRESSES=sales@kirancable.com

# Optional: seal the stored mailbox password with a real key rather than obfuscation.
KIRAN_MAIL_KEY=

# ---------------------------------------------------------------------------
# The customer's confirmation link
# ---------------------------------------------------------------------------
# The base URL the invitation link is built against — the address the customer will open
# in their browser. The Vite dev server is 5173; a built console served by something else
# will differ.
KIRANOS_APP_URL=http://localhost:5173

# How long an invitation stays usable. An expired link returns the order to a person; it
# is never treated as agreement.
CLIENT_CONFIRM_TTL_HOURS=168

# ---------------------------------------------------------------------------
# PACT, through KPAC
# ---------------------------------------------------------------------------
# KPAC is the pywinauto robot at C:\Users\prach\pact-automation. It binds loopback and has
# no authentication of its own, so it must never be pointed off this host.
PACT_AUTOMATION_URL=http://127.0.0.1:8765
PACT_AUTOMATION_TOKEN=
PACT_AUTOMATION_TIMEOUT=30

# Which PACT screen the robot drives. `pact_purchase_order` is the one proven against the
# live window. This is configuration so the screen can change without a code change.
KPAC_PROFILE=pact_purchase_order

# One gate or two. Off (the default), an admin approves and then Accounts release the
# order into PACT as a separate click. On, the admin's approval does both: the customer is
# acknowledged, the teams are tasked, and the robot fills and saves the PACT draft at once.
# The order still passes through every state, so the timeline and the Accounts queue keep
# working if this is turned off again.
PACT_AUTO_RELEASE=false

# Extra customer-name translations, as `KiranOS Name=PACT Name`, separated by `;`.
# The four demo customers map to themselves and need no entry. A name that is not in the
# table fails that order with "customer not in PACT master: <name>" — never a near-match.
PACT_MASTER_MAP=

# Extra product-code mappings, same syntax. The built-in codes were read off the live PACT
# window; see C:\Users\prach\pact-automation\demo\discovered_values.md.
PACT_PRODUCT_MAP=

# ---------------------------------------------------------------------------
# Model access (optional)
# ---------------------------------------------------------------------------
# Extraction is deterministic and local, so the pipeline needs no key. This is only for
# the in-console assistant.
ANTHROPIC_API_KEY=

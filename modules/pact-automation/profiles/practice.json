{
  "window": { "title_re": "PACT RevenU - Practice Form" },
  "duplicate_key": ["customer_name"],
  "fields": {
    "customer_name": { "auto_id": "txtCustomerName", "type": "edit", "required": true },
    "phone":         { "auto_id": "txtPhone",        "type": "edit", "validate": "phone" },
    "email":         { "auto_id": "txtEmail",        "type": "edit", "validate": "email" },
    "city":          { "auto_id": "cmbCity",         "type": "combo",
                       "options": ["Mumbai", "Pune", "Delhi", "Bengaluru", "Hyderabad", "Dubai"] },
    "credit_limit":  { "auto_id": "txtCreditLimit",  "type": "edit", "validate": "number" },
    "active":        { "auto_id": "chkActive",       "type": "check" },
    "notes":         { "auto_id": "txtNotes",        "type": "edit", "validate": "text" }
  },
  "actions": {
    "new":  { "auto_id": "btnNew",  "type": "button" },
    "save": { "auto_id": "btnSave", "type": "button" }
  },
  "confirmation": {
    "auto_id": "lblStatus",
    "success_re": "^Saved: (?P<record_id>.+)$",
    "error_re": "^Error"
  },
  "verify_labels": {
    "customer_name": "Customer Name", "phone": "Phone", "email": "Email", "city": "City",
    "credit_limit": "Credit Limit", "active": "Active", "notes": "Notes"
  }
}
